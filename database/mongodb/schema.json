{
  "database": "oa_logs",
  "description": "MongoDB is used exclusively for logging, transcripts, emotion analysis, and debug data. No auth or relational data is stored here.",
  "collections": {
    "interview_logs": {
      "description": "Full interview session logs including transcripts and AI analysis",
      "schema": {
        "userId": "string (UUID from PostgreSQL)",
        "interviewId": "string (UUID from PostgreSQL)",
        "transcript": "string",
        "emotions": "object (emotion analysis data)",
        "performance": "object (performance metrics)",
        "metadata": "object (additional session metadata)",
        "createdAt": "date"
      },
      "indexes": [
        { "key": { "userId": 1 } },
        { "key": { "interviewId": 1 } },
        { "key": { "createdAt": -1 } }
      ]
    },
    "emotion_batches": {
      "description": "Batched emotion detection results from video/audio analysis",
      "schema": {
        "userId": "string",
        "sessionId": "string",
        "emotions": "array of emotion objects",
        "timestamp": "date",
        "createdAt": "date"
      },
      "indexes": [
        { "key": { "sessionId": 1 } },
        { "key": { "createdAt": -1 } }
      ]
    },
    "text_sentiment_logs": {
      "description": "Text-based sentiment analysis results",
      "schema": {
        "userId": "string",
        "sessionId": "string",
        "text": "string",
        "sentiment": "object",
        "confidence": "number",
        "createdAt": "date"
      },
      "indexes": [
        { "key": { "sessionId": 1 } },
        { "key": { "createdAt": -1 } }
      ]
    },
    "voice_emotion_logs": {
      "description": "Voice-based emotion analysis results",
      "schema": {
        "userId": "string",
        "sessionId": "string",
        "emotions": "array",
        "audioMetadata": "object",
        "createdAt": "date"
      },
      "indexes": [
        { "key": { "sessionId": 1 } },
        { "key": { "createdAt": -1 } }
      ]
    },
    "debug_logs": {
      "description": "Debug and session tracking logs",
      "schema": {
        "userId": "string (optional)",
        "sessionId": "string (optional)",
        "action": "string",
        "details": "object",
        "createdAt": "date"
      },
      "indexes": [
        { "key": { "createdAt": -1 } },
        { "key": { "action": 1 } }
      ]
    }
  }
}
